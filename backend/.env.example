# 服务器配置
PORT=3002
NODE_ENV=development

# API配置
API_PREFIX=/api

# 影刀联用任务台回传密钥（可选）
# 未配置时仅允许本机调用 /api/shadow-knife-linkage/workbench/sync
SHADOW_KNIFE_WEBHOOK_KEY=

# 认证配置
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# 数据库配置 (默认使用 SQLite)
# 可选值: sqlite, mysql, postgres
DB_TYPE=sqlite

# SQLite 配置
# 数据库文件路径 (相对于 backend 目录或绝对路径)
DB_FILE_PATH=./instrument_management.db

# 云数据库/远程数据库配置 (当 DB_TYPE 为 mysql 或 postgres 时生效)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=instrument_db
# DB_SSL=false
