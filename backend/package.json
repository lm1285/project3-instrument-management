{
  "name": "instrument-management-backend",
  "version": "1.0.0",
  "description": "仪器管理系统后端服务",
  "main": "src/index.ts",
  "scripts": {
    "start": "ts-node src/index.ts",
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start:prod": "node dist/index.js",
    "serve:prod": "node -e \"const {spawnSync}=require('node:child_process'); const env={...process.env,PORT:'3002'}; const result=spawnSync(process.execPath,['dist/index.js'],{stdio:'inherit',env}); process.exit(result.status ?? 1);\""
  },
  "dependencies": {
    "@types/multer": "^2.0.0",
    "axios": "^1.13.5",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jszip": "^3.10.1",
    "multer": "^2.0.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.24",
    "@types/office-js": "^1.0.569",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "instrument",
    "management",
    "backend",
    "express"
  ],
  "author": "",
  "license": "ISC"
}
